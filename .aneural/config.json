{
  "$schema": "https://aneural.dev/schema/config-v1.json",
  "version": 1,
  "name": "Aneural",
  "roots": [
    "."
  ],
  "respectGitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**",
    "**/.turbo/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/vendor/**"
  ],
  "languages": [
    "typescript",
    "javascript",
    "python",
    "rust",
    "go",
    "java",
    "php",
    "ruby"
  ],
  "typescript": {
    "tsconfig": "auto",
    "conditionNames": [
      "import",
      "require",
      "node",
      "types",
      "default"
    ]
  },
  "spores": {
    "enabled": [
      "aneural.comments",
      "aneural.plans",
      "aneural.icebox",
      "aneural.wiki-links"
    ],
    "registries": [
      {
        "name": "official",
        "url": "https://raw.githubusercontent.com/Parnassix/aneural/main/registry/index.json"
      }
    ]
  },
  "nodeTypes": {},
  "gui": {
    "theme": "mycelium-dark",
    "labelZoomThreshold": 0.8,
    "growthBudgetPerFrame": 200,
    "circadian": "auto"
  },
  "history": {
    "git": true,
    "maxCommits": 2000,
    "claude": true,
    "claudePrompts": false
  }
}
