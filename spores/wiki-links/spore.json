{
  "$schema": "https://aneural.dev/schema/spore-v2.json",
  "publisher": "aneural",
  "name": "wiki-links",
  "version": "0.2.0",
  "displayName": "Notes & Wiki-links",
  "description": "Obsidian-style knowledge, vault or no vault: `.aneural/notes/*.md` become Note nodes, every `[[Wiki Link]]` becomes a RELATES_TO edge, frontmatter `tags:` become shared Tag nodes, links written to a note's `aliases:` resolve, and a link to a note nobody has written yet is kept as a Missing Note rather than dropped.",
  "license": "MIT",
  "aneural": ">=0.1",
  "nodeTypes": [
    {
      "kind": "Note",
      "label": "Note",
      "icon": "LuStickyNote",
      "color": "#86c5c0",
      "shape": "square",
      "description": "A note kept in .aneural/notes"
    },
    {
      "kind": "Tag",
      "label": "Tag",
      "icon": "LuTag",
      "color": "#c9a227",
      "shape": "pill",
      "description": "A frontmatter tag, shared by every file carrying it"
    },
    {
      "kind": "MissingNote",
      "label": "Missing note",
      "icon": "LuLink",
      "color": "#7a7f87",
      "shape": "diamond",
      "description": "A note something links to that nobody has written yet"
    }
  ],
  "edgeTypes": [
    {
      "kind": "RELATES_TO",
      "label": "relates to",
      "style": "dashed"
    }
  ],
  "harvesters": [
    {
      "id": "notes",
      "kind": "markdown",
      "include": [
        ".aneural/notes/**/*.md"
      ],
      "granularity": "document",
      "emit": {
        "node": {
          "kind": "Note",
          "id": "note:{file}",
          "label": "{title}",
          "props": {
            "file": "{file}"
          }
        },
        "edges": [
          {
            "kind": "RELATES_TO",
            "src": "$node",
            "dst": "file:{file}",
            "props": {
              "via": "source"
            }
          }
        ]
      },
      "wikilinks": {
        "edgeKind": "RELATES_TO",
        "unresolved": {
          "kind": "MissingNote",
          "id": "missing:{slug}",
          "label": "{target}",
          "props": {
            "target": "{target}"
          }
        }
      },
      "tags": {
        "frontmatterKey": "tags",
        "edgeKind": "RELATES_TO",
        "node": {
          "kind": "Tag",
          "id": "tag:{slug}",
          "label": "{tag}",
          "props": {
            "tag": "{tag}"
          }
        }
      }
    },
    {
      "id": "links",
      "kind": "markdown",
      "include": [
        "**/*.md",
        "**/*.mdx"
      ],
      "exclude": [
        ".aneural/notes/**"
      ],
      "granularity": "document",
      "wikilinks": {
        "edgeKind": "RELATES_TO",
        "unresolved": {
          "kind": "MissingNote",
          "id": "missing:{slug}",
          "label": "{target}",
          "props": {
            "target": "{target}"
          }
        }
      },
      "tags": {
        "frontmatterKey": "tags",
        "edgeKind": "RELATES_TO",
        "node": {
          "kind": "Tag",
          "id": "tag:{slug}",
          "label": "{tag}",
          "props": {
            "tag": "{tag}"
          }
        }
      }
    }
  ]
}
